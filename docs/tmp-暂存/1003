WITH t1 AS (
    -- 步骤 1: 计算每日的典型价格 TP
    SELECT
        stockCode,
        date,
        (high + low + last) / 3.0 AS tp
    FROM t_stock_raw
    where date > '2026-06-01'
),
t2 AS (
    -- 步骤 2: 计算 14 日 TP 的移动平均值 MA
    SELECT
        stockCode,
        date,
        tp,
        AVG(tp) OVER(
            PARTITION BY stockCode
            ORDER BY date
            ROWS BETWEEN 13 PRECEDING AND CURRENT ROW
        ) AS ma
    FROM t1
),
t3 AS (
    -- 步骤 3: 模拟计算平均绝对偏差 MD
    -- 用窗口函数再次前溯 14 天，计算每项 |TP_i - 当前MA| 的平均值
    SELECT
        stockCode,
        date,
        tp,
        ma,
        AVG(ABS(tp - ma)) OVER(
            PARTITION BY stockCode
            ORDER BY date
            ROWS BETWEEN 13 PRECEDING AND CURRENT ROW
        ) AS md
    FROM t2
)
-- 步骤 4: 最终输出 CCI 指标
SELECT
    stockCode,
    date,
    tp,
    ma,
    md,
    CASE
        WHEN md = 0 THEN 0 -- 防止分母为 0
        ELSE (tp - ma) / (0.015 * md)
    END AS cci
FROM t3
ORDER BY stockCode desc, date desc;

