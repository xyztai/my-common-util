WITH boll_calculation AS (
    SELECT
        stockCode,
        `date` ,
        `last` ,
        -- 1. 计算20日移动平均线（中轨）
        AVG(`last` ) OVER(
            PARTITION BY stockCode
            ORDER BY `date`
            ROWS BETWEEN 4 PRECEDING AND CURRENT ROW
        ) AS mb_5,
        -- 1. 计算20日移动平均线（中轨）
        AVG(`last` ) OVER(
            PARTITION BY stockCode
            ORDER BY `date`
            ROWS BETWEEN 9 PRECEDING AND CURRENT ROW
        ) AS mb_10,
        -- 1. 计算20日移动平均线（中轨）
        AVG(`last` ) OVER(
            PARTITION BY stockCode
            ORDER BY `date`
            ROWS BETWEEN 19 PRECEDING AND CURRENT ROW
        ) AS mb_20,
        -- 1. 计算20日移动平均线（中轨）
        AVG(`last` ) OVER(
            PARTITION BY stockCode
            ORDER BY `date`
            ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
        ) AS mb_30,
        -- 2. 计算20日总体标准差（MySQL的 STDDEV_SAMP 函数）
        STDDEV_SAMP(`last`) OVER(
            PARTITION BY stockCode
            ORDER BY `date`
            ROWS BETWEEN 19 PRECEDING AND CURRENT ROW
        ) AS std_dev
    FROM t_stock_raw
    where date > '2026-06-01'
)
, tmp_boll as (
	SELECT
	        stockCode,
	        `date` ,
	        `last` ,
	        mb_5,
	        mb_10,
	        mb_20,
	        mb_30,
		    ROUND(mb_20, 4) AS MB,                       -- 中轨
		    ROUND(mb_20 + (2 * std_dev), 4) AS UP,       -- 上轨
		    ROUND(mb_20 - (2 * std_dev), 4) AS DN        -- 下轨
	FROM boll_calculation
	-- where LAST >= 0.99 * mb_5
	-- and mb_5 >= 0.99 * mb_10
	-- and mb_10 >= 0.99 * mb_20
	-- and mb_20 >= 0.99 * mb_30
)
select *
from tmp_boll t
-- where t.last < t.dn
ORDER BY stockCode, date desc;

