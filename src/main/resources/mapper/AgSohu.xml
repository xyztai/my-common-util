<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.my.mapper.AgSinaMapper">
    <select id="getStocks" resultType="java.lang.String">
        <![CDATA[
        select concat(t.stockType, '.', t.stockCode)
        from t_stock t
        -- where stockCode = '601212'
        order by 1
        ]]>
    </select>

    <select id="getEtfs" resultType="java.lang.String">
        <![CDATA[
        select concat(t.stockType, '.', t.stockCode)
        from t_etf t
        -- where stockCode = '000001'
        order by 1
        ]]>
    </select>

    <select id="getIndexs" resultType="java.lang.String">
        <![CDATA[
        select DISTINCT fullStockCode
        from t_index
        ]]>
    </select>

    <insert id="saveDataSina" parameterType="java.util.List">
        replace into t_history_sina(`day`, `code`, `open`, `close`, `high`, `low`, `volume`)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.day}, #{item.code}, #{item.open}, #{item.close}, #{item.high}, #{item.low}, #{item.volume}
            )
        </foreach>
    </insert>

</mapper>