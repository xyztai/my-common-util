<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.my.mapper.AgSohuMapper">
    <select id="getStocks" resultType="java.lang.String">
        <![CDATA[
        select concat(t.stockType, '.', t.stockCode)
        from t_hs300 t
        -- where stockCode = '601212'
        order by 1
        ]]>
    </select>

    <select id="getEtfs" resultType="java.lang.String">
        <![CDATA[
        select concat(t.stockType, '.', t.stockCode)
        from t_etf t
        -- where stockCode = '000001'
        order by 1
        ]]>
    </select>

    <select id="getIndexs" resultType="java.lang.String">
        <![CDATA[
        select distinct stockCode
        from t_eastmoney_node_str
        ]]>
    </select>

    <select id="getMaxDateFromStock" resultType="java.lang.String">
        <![CDATA[
        select max(`date`)
        from t_eastmoney_node ten
        where ten.`date` >= '2026-01-01'
        and ten.`date` not like '9999%'
        ]]>
    </select>

    <select id="getMaxDateFromEtf" resultType="java.lang.String">
        <![CDATA[
        select max(`date`)
        from t_eastmoney_node_etf ten
        where ten.`date` >= '2026-01-01'
        and ten.`date` not like '9999%'
        ]]>
    </select>

    <insert id="saveDataSohu" parameterType="java.util.List">
        replace into t_sohu_data_history(`day`, `code`, `open`, `close`, `high`, `low`, `volume`)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.day}, #{item.code}, #{item.open}, #{item.close}, #{item.high}, #{item.low}, #{item.volume} }
            )
        </foreach>
    </insert>

</mapper>