<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.my.mapper.AgEastmoneyIndexMapper">

    <insert id="saveIndexEastMoneyDatas" parameterType="java.util.List">
        insert into t_eastmoney_node_index(`date`, `stockCode`, `infoRaw`)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.date}, #{item.stockCode}, #{item.infoRaw}
            )
        </foreach>
    </insert>

</mapper>